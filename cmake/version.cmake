# Writes Version.h with the version, the commit and the build date, at every build, touching the
# file only when they change. Run by the twill_version target: cmake -DSRC= -DOUT= -DVERSION= -P.
execute_process(COMMAND git -C "${SRC}" rev-parse --short HEAD
                OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C "${SRC}" status --porcelain --untracked-files=no
                OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT commit)
  set(commit "unknown")
elseif(changes)
  set(commit "${commit}+")  # built with uncommitted changes
endif()
string(TIMESTAMP date "%Y-%m-%d")
set(text "// Generated by cmake/version.cmake at build time.\n#pragma once\n#define TWILL_VERSION \"${VERSION}\"\n#define TWILL_COMMIT \"${commit}\"\n#define TWILL_BUILD_DATE \"${date}\"\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT "${old}" STREQUAL "${text}")
  file(WRITE "${OUT}" "${text}")
endif()
