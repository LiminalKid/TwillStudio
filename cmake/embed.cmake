# Turns every file in DIR into a byte array in OUT (a C++ source), with a table of their names, so
# the app carries them inside its binary. Run with cmake -DDIR=... -DOUT=... -P embed.cmake.
file(GLOB files RELATIVE "${DIR}" "${DIR}/*.wav")
list(SORT files)
set(body "// Generated by cmake/embed.cmake from ${DIR}. Do not edit.\n#include \"app/FactoryData.h\"\n\nnamespace twill {\nnamespace {\n")
set(table "")
set(i 0)
foreach(f IN LISTS files)
  file(READ "${DIR}/${f}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" hex "${hex}")
  string(APPEND body "const unsigned char file${i}[] = {\n${hex}};\n")
  string(APPEND table "    {\"${f}\", file${i}, ${bytes}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "}  // namespace\n\nconst EmbeddedFile kFactoryFiles[] = {\n${table}};\nconst int kNumFactoryFiles = ${i};\n\n}  // namespace twill\n")
file(WRITE "${OUT}" "${body}")
