{
  "version": 3,
  "configurePresets": [
    {
      "name": "macos",
      "displayName": "macOS (SDL2 from Homebrew)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "knulli",
      "displayName": "KNULLI handhelds, AArch64 (TrimUI Brick Pro)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/knulli",
      "toolchainFile": "${sourceDir}/cmake/toolchains/knulli-aarch64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-sndstation",
      "displayName": "macOS with the sndstation SDK (development)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-sndstation",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TWILL_SNDSTATION": "ON"
      }
    },
    {
      "name": "sndstation",
      "displayName": "sndstation handhelds, AArch64 (Debian 13)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/sndstation",
      "toolchainFile": "${sourceDir}/cmake/toolchains/sndstation-aarch64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos",
      "configurePreset": "macos"
    },
    {
      "name": "knulli",
      "configurePreset": "knulli"
    },
    {
      "name": "macos-sndstation",
      "configurePreset": "macos-sndstation"
    },
    {
      "name": "sndstation",
      "configurePreset": "sndstation"
    }
  ]
}
